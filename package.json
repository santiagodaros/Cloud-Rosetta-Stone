{
  "name": "letra-chica",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Comparador open source de patrones de arquitectura entre Azure, AWS y GCP.",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "validate": "tsx scripts/validate-content.ts",
    "freshness": "tsx scripts/freshness-report.ts",
    "tf:matrix": "tsx scripts/terraform-matrix.ts",
    "verify": "pnpm validate && pnpm check && pnpm test && pnpm build",
    "new:pattern": "tsx scripts/new-pattern.ts",
    "lighthouse": "lhci autorun",
    "launch:weekly": "tsx scripts/gotcha-of-the-week.ts"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.6",
    "elkjs": "^0.12.0",
    "satori": "^0.35.1",
    "tailwindcss": "^4.3.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@lhci/cli": "^0.15.1",
    "@types/node": "^26.6.4",
    "pagefind": "^1.5.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
