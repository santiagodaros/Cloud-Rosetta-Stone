{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": [
        "http://localhost/es/",
        "http://localhost/es/patterns/private-web-api/azure-vs-aws/",
        "http://localhost/en/patterns/async-worker/all/",
        "http://localhost/es/capabilities/",
        "http://localhost/es/concepts/",
        "http://localhost/en/terraform/",
        "http://localhost/es/changes/",
        "http://localhost/es/practice/",
        "http://localhost/en/exams/az-104/",
        "http://localhost/es/migrate/",
        "http://localhost/en/adr/",
        "http://localhost/es/decide/managed-postgres/",
        "http://localhost/en/embed/compare/private-web-api/all/"
      ],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "^(?!.*/embed/).*$",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.9
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 0.9
              }
            ],
            "categories:seo": [
              "error",
              {
                "minScore": 0.9
              }
            ]
          }
        },
        {
          "matchingUrlPattern": ".*/embed/.*",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.9
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 0.9
              }
            ],
            "categories:seo": "off"
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./.lighthouseci"
    }
  }
}
