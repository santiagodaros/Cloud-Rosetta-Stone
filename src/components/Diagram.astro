---
import type { DiagramLayout, NodeContent } from '../lib/diagram.ts';

interface Props {
  layout: DiagramLayout;
  contents: Record<string, NodeContent>;
  color: string;
  title: string;
  /** Gotchas por rol en esta nube (badge en el nodo). */
  counts?: Record<string, number>;
  /** Texto accesible para el contador. */
  countLabel?: (n: number) => string;
}

const { layout, contents, color, title, counts = {}, countLabel = (n: number) => String(n) } = Astro.props;
const pad = 12;
const markerId = `arrow-${Math.random().toString(36).slice(2, 8)}`;
---

<div class="overflow-x-auto">
<svg
  viewBox={`${-pad} ${-pad} ${layout.width + pad * 2} ${layout.height + pad * 2}`}
  role="group"
  aria-label={title}
  class="dg mx-auto h-auto w-full min-w-[540px] md:min-w-0"
  style={`--node: ${color}; max-width: ${Math.round(layout.width * 1.15)}px`}
>
  <title>{title}</title>
  <defs>
    <marker id={markerId} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0,0 L10,5 L0,10 z" fill="var(--c-muted)"></path>
    </marker>
  </defs>
  {
    layout.edges.map((e) => (
      <g class="dg-edge" data-from={e.from} data-to={e.to}>
        <path d={e.path} fill="none" stroke="var(--c-muted)" stroke-width="1.4" marker-end={`url(#${markerId})`} />
        {e.label && (
          <text x={e.label.x} y={e.label.y} text-anchor="middle" dominant-baseline="central" font-size="11" fill="var(--c-muted)" paint-order="stroke" stroke="var(--c-surface)" stroke-width="4">
            {e.label.text}
          </text>
        )}
      </g>
    ))
  }
  {
    layout.nodes.map((n) => {
      const c = contents[n.id];
      const cx = n.x + n.width / 2;
      // Todas las nubes comparten alto de nodo (el máximo); centramos el texto.
      const top = n.y + (n.height - (28 + 16 + 16 * c.lines.length)) / 2;
      const count = counts[n.id] ?? 0;
      // Nombre accesible = texto visible del nodo (WCAG 2.5.3); el contador va como descripción.
      const descId = `${markerId}-${n.id}-count`;
      return (
        <g class="dg-node" data-role={n.id} data-actor={c.actor ? '' : undefined} tabindex={c.actor ? undefined : 0} role={c.actor ? undefined : 'button'} aria-describedby={!c.actor && count > 0 ? descId : undefined}>
          <rect
            x={n.x}
            y={n.y}
            width={n.width}
            height={n.height}
            rx="8"
            fill={c.actor ? 'var(--c-surface-2)' : 'var(--c-surface)'}
            stroke={c.gap ? 'var(--c-bad)' : c.actor ? 'var(--c-border)' : 'var(--node)'}
            stroke-width={c.actor ? 1 : 1.6}
            stroke-dasharray={c.gap ? '5 4' : c.partial ? '2 3' : undefined}
          />
          {c.actor ? (
            <text x={cx} y={n.y + n.height / 2} text-anchor="middle" dominant-baseline="central" font-size="12.5" font-weight="600" fill="var(--c-text)">
              {c.role}
            </text>
          ) : (
            <>
              <text x={cx} y={top + 14 + 8} text-anchor="middle" font-size="10.5" fill="var(--c-muted)">
                {c.role}
                {c.partial && ' ≈'}
              </text>
              {c.lines.map((line, i) => (
                <text
                  x={cx}
                  y={top + 14 + 16 + 12 + i * 16}
                  text-anchor="middle"
                  font-size="12.5"
                  font-weight="600"
                  fill={c.gap ? 'var(--c-bad)' : 'var(--c-text)'}
                >
                  {line}
                </text>
              ))}
              {count > 0 && <text id={descId} display="none">{countLabel(count)}</text>}
              {count > 0 && (
                <g aria-hidden="true">
                  <circle cx={n.x + n.width - 2} cy={n.y + 2} r="9" fill="var(--node)" />
                  <text x={n.x + n.width - 2} y={n.y + 2} text-anchor="middle" dominant-baseline="central" font-size="10.5" font-weight="700" fill="var(--c-bg)">
                    {count}
                  </text>
                </g>
              )}
            </>
          )}
        </g>
      );
    })
  }
</svg>
</div>
