---
import type { Gotcha } from '../lib/schema.ts';
import { daysSince, STALE_AFTER_DAYS } from '../lib/content.ts';
import { isFallback, t, ui, type Locale } from '../lib/i18n.ts';
import { examsHref } from '../lib/paths.ts';

interface Props {
  gotcha: Gotcha;
  lang: Locale;
  anchor: string;
  /** Nivel del título según dónde se usa la tarjeta (el orden de headings importa para a11y). */
  level?: 3 | 4;
}

const { gotcha: g, lang, anchor, level = 4 } = Astro.props;
const Heading = `h${level}` as 'h3' | 'h4';
const s = ui(lang);
const age = daysSince(g.verified_at);
const freshness = age > STALE_AFTER_DAYS ? 'bad' : age > STALE_AFTER_DAYS - 30 ? 'warn' : 'ok';
const shortUrl = (u: string) => {
  const url = new URL(u);
  const last = url.pathname.split('/').filter(Boolean).pop() ?? '';
  return `${url.hostname.replace(/^www\./, '')} › ${last.replace(/\.html?$/, '')}`;
};
---

<article id={anchor} class="scroll-mt-20 rounded-lg border border-line bg-surface p-4">
  <div class="mb-2 flex flex-wrap items-center gap-2 text-xs" data-pagefind-ignore>
    <span class="rounded-full px-2 py-0.5 font-semibold" style={`color: var(--c-sev-${g.severity}); background: color-mix(in srgb, var(--c-sev-${g.severity}) 12%, transparent)`}>
      {s.severity[g.severity]}
    </span>
    <span
      class:list={['rounded-full px-2 py-0.5', { 'text-ok': freshness === 'ok', 'text-warn': freshness === 'warn', 'text-bad': freshness === 'bad' }]}
      title={g.verified_at}
    >
      ● {s.verified(age)}{freshness === 'bad' && ` · ${s.stale}`}
    </span>
    {isFallback(g.title, lang) && <span class="text-muted italic">({s.untranslated})</span>}
  </div>
  <Heading class="mb-1.5 flex items-start gap-2 text-[15px] leading-snug font-semibold">
    <a href={`#${anchor}`} class="flex-1 text-fg no-underline hover:underline">{t(g.title, lang)}</a>
    <button
      type="button"
      data-pagefind-ignore
      class="gotcha-link shrink-0 rounded px-1 text-xs font-normal text-muted hover:bg-surface-2 hover:text-fg"
      data-anchor={anchor}
      data-done={s.linkCopied}
      aria-label={s.copyLink}
      title={s.copyLink}>🔗</button>
  </Heading>
  <p class="text-sm leading-relaxed text-muted">{t(g.body, lang)}</p>
  <div class="mt-3 flex flex-wrap items-center justify-between gap-2 text-xs" data-pagefind-ignore>
    <ul class="flex flex-col gap-0.5">
      {
        g.sources.map((src) => (
          <li>
            <a href={src} rel="noopener" target="_blank" class="inline-flex min-h-6 items-center no-underline! hover:underline!">↗ {shortUrl(src)}</a>
          </li>
        ))
      }
    </ul>
    {
      g.exams.length > 0 && (
        <div class="flex flex-wrap items-center gap-1 text-muted">
          <span>{s.exams}:</span>
          {g.exams.map((e) => (
            <a href={examsHref(lang, e)} class="inline-flex min-h-6 items-center rounded border border-line px-1.5 font-mono text-[11px] text-muted no-underline! hover:border-accent hover:text-fg">{e}</a>
          ))}
        </div>
      )
    }
  </div>
</article>

<script>
  document.querySelectorAll<HTMLButtonElement>('.gotcha-link').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const url = `${location.origin}${location.pathname}#${btn.dataset.anchor}`;
      try {
        await navigator.clipboard.writeText(url);
        btn.textContent = '✓';
        btn.title = btn.dataset.done ?? '';
      } catch {
        location.hash = btn.dataset.anchor ?? '';
      }
      setTimeout(() => (btn.textContent = '🔗'), 1500);
    });
  });
</script>
