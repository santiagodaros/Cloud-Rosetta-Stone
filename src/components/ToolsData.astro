---
/** JSON localizado que consumen las herramientas (checklist de migración y ADR). */
import { site, publishedPatterns } from '../lib/site.ts';
import { patternHref } from '../lib/paths.ts';
import { toolStrings, toolsData } from '../lib/tools.ts';
import { formatUsd, patternFloor } from '../lib/pricing.ts';
import type { Provider } from '../lib/schema.ts';
import { ui, type Locale } from '../lib/i18n.ts';

interface Props {
  lang: Locale;
  extra?: Record<string, unknown>;
}
const { lang, extra = {} } = Astro.props;
const urlFor = (id: string, anchor?: string) => new URL(`${patternHref(lang, id, 'all')}${anchor ? `#${anchor}` : ''}`, Astro.site).href;
const floorFor = (id: string, p: Provider) => {
  const f = patternFloor(id, p, site.pricing, site.prices);
  // Un piso incompleto no se cita en un ADR ni en un checklist: sería un número engañoso.
  return f?.complete ? `${formatUsd(f.total, lang)}/${ui(lang).priceUnit.month}` : undefined;
};
const payload = { data: toolsData(publishedPatterns, site.terraformMap, lang, urlFor, floorFor), S: toolStrings(lang), ...extra };
---

<script is:inline type="application/json" id="tools-data" set:html={JSON.stringify(payload).replace(/</g, '\\u003c')} />
