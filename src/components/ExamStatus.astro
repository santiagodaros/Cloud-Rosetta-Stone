---
import type { Exam } from '../lib/schema.ts';
import { examStatus } from '../lib/content.ts';
import { ui, type Locale } from '../lib/i18n.ts';

interface Props {
  exam: Exam;
  lang: Locale;
}

const { exam, lang } = Astro.props;
const s = ui(lang);
const status = examStatus(exam);
---

<span
  class:list={[
    'rounded-full px-2 py-0.5 text-xs font-semibold',
    { 'text-ok': status === 'active', 'text-warn': status === 'retiring', 'text-bad': status === 'retired' },
  ]}
  style="background: color-mix(in srgb, currentColor 12%, transparent)"
  title={exam.retires_on ? s.examRetiresOn(exam.retires_on) : undefined}
>
  {s.examStatus[status]}{exam.retires_on && ` · ${exam.retires_on}`}
</span>
