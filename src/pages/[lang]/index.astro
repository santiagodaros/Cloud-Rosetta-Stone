---
import { BRAND } from '../../lib/brand.ts';
import Base from '../../layouts/Base.astro';
import { LOCALES, PROVIDER_META, t, ui, type Locale } from '../../lib/i18n.ts';
import { adrHref, capabilitiesHref, migrateHref, patternHref, practiceHref } from '../../lib/paths.ts';
import { PROVIDERS } from '../../lib/schema.ts';
import { allGotchas, DEFAULT_VIEW, publishedPatterns, site } from '../../lib/site.ts';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const s = ui(lang);
// Gotcha del día: se elige en el cliente con la fecha local (el build es semanal).
const daily = allGotchas.map(({ pattern, provider, gotcha: g, anchor }) => ({
  title: t(g.title, lang),
  body: t(g.body, lang),
  cloud: PROVIDER_META[provider].short,
  color: PROVIDER_META[provider].color,
  pattern: t(pattern.title, lang),
  href: `${patternHref(lang, pattern.id, 'all')}#${anchor}`,
}));
const totalGotchas = publishedPatterns.reduce(
  (n, p) => n + PROVIDERS.reduce((m, pr) => m + (p.implementations[pr]?.gotchas.length ?? 0), 0),
  0,
);
---

<Base lang={lang} title={`${BRAND.name} — ${s.patterns}`} description={s.tagline}>
  <section class="mb-10 max-w-3xl">
    <h1 class="mb-3 text-3xl font-bold tracking-tight sm:text-4xl">{BRAND.name}</h1>
    <p class="text-lg text-muted">{s.tagline}</p>
    <div class="mt-4 flex flex-wrap gap-2 text-sm">
      {PROVIDERS.map((p) => <span class="rounded-full border px-3 py-0.5 font-medium" style={`border-color: ${PROVIDER_META[p].color}; color: ${PROVIDER_META[p].color}`}>{PROVIDER_META[p].short}</span>)}
      <span class="px-2 py-0.5 text-muted">· {s.patternCount(publishedPatterns.length)} · {s.gotchaCount(totalGotchas)} · <a class="underline underline-offset-2" href={capabilitiesHref(lang)}>{s.capabilityCount(site.capabilities.length)}</a></span>
    </div>
    <p class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-sm">
      <a class="inline-flex min-h-6 items-center" href={migrateHref(lang)}>☑ {s.migrateNav} →</a>
      <a class="inline-flex min-h-6 items-center" href={adrHref(lang)}>✎ {s.adrNav} →</a>
    </p>
  </section>

  <section id="daily" class="mb-10 max-w-3xl rounded-xl border border-line bg-surface p-5" hidden aria-labelledby="daily-title">
    <p class="mb-2 flex items-center gap-2 text-xs">
      <span id="daily-title" class="font-semibold tracking-wide text-muted uppercase">{s.dailyTitle}</span>
      <span id="daily-cloud" class="font-bold"></span>
      <span id="daily-pattern" class="text-muted"></span>
    </p>
    <p class="mb-2 text-lg leading-snug font-semibold"><a id="daily-link" class="text-fg no-underline hover:underline"></a></p>
    <p id="daily-body" class="mb-3 text-sm leading-relaxed text-muted"></p>
    <a class="text-sm" href={practiceHref(lang)}>🃏 {s.dailyMore} →</a>
  </section>
  <script is:inline type="application/json" id="daily-data" set:html={JSON.stringify(daily)} />

  <section>
    <h2 class="mb-4 text-sm font-semibold tracking-wide text-muted uppercase">{s.patterns}</h2>
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        publishedPatterns.map(({ pattern, implementations }) => {
          const n = PROVIDERS.reduce((m, p) => m + (implementations[p]?.gotchas.length ?? 0), 0);
          return (
            <li class="flex flex-col rounded-xl border border-line bg-surface p-5">
              <h3 class="mb-2 text-lg leading-snug font-semibold">
                <a class="text-fg no-underline hover:underline" href={patternHref(lang, pattern.id, DEFAULT_VIEW)} data-pattern-link data-default-view={DEFAULT_VIEW}>{t(pattern.title, lang)}</a>
              </h3>
              <p class="mb-4 flex-1 text-sm text-muted">{t(pattern.summary, lang)}</p>
              <div class="flex flex-wrap items-center gap-2 text-xs text-muted">
                {pattern.tags.map((tag) => (
                  <span class="rounded bg-surface-2 px-1.5 py-0.5">{tag}</span>
                ))}
                <span class="ml-auto">{s.gotchaCount(n)}</span>
              </div>
            </li>
          );
        })
      }
    </ul>
  </section>
</Base>

<script>
  import { dailyIndex, localDay } from '../../lib/leitner.ts';

  type Daily = { title: string; body: string; cloud: string; color: string; pattern: string; href: string };
  const items: Daily[] = JSON.parse(document.getElementById('daily-data')!.textContent!);
  if (items.length) {
    const g = items[dailyIndex(localDay(), items.length)];
    const link = document.getElementById('daily-link') as HTMLAnchorElement;
    link.textContent = g.title;
    link.href = g.href;
    const cloud = document.getElementById('daily-cloud')!;
    cloud.textContent = g.cloud;
    cloud.style.color = g.color;
    document.getElementById('daily-pattern')!.textContent = `· ${g.pattern}`;
    document.getElementById('daily-body')!.textContent = g.body;
    document.getElementById('daily')!.hidden = false;
  }
</script>
