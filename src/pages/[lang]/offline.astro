---
import { BRAND } from '../../lib/brand.ts';
import Base from '../../layouts/Base.astro';
import { LOCALES, ui, type Locale } from '../../lib/i18n.ts';
import { homeHref } from '../../lib/paths.ts';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const s = ui(lang);
---

<Base lang={lang} title={`${s.offlineTitle} — ${BRAND.name}`} description={s.offlineBody} altPath="offline/">
  <h1 class="mb-2 text-2xl font-bold tracking-tight sm:text-3xl">{s.offlineTitle}</h1>
  <p class="mb-4 max-w-2xl text-muted">{s.offlineBody}</p>
  <p><a href={homeHref(lang)}>← {BRAND.name}</a></p>
</Base>
