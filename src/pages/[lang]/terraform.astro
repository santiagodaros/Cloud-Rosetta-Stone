---
import { BRAND } from '../../lib/brand.ts';
import Base from '../../layouts/Base.astro';
import DictionaryTabs from '../../components/DictionaryTabs.astro';
import { LOCALES, PROVIDER_META, t, ui, type Locale } from '../../lib/i18n.ts';
import { capabilitiesHref, conceptsHref } from '../../lib/paths.ts';
import { PROVIDERS } from '../../lib/schema.ts';
import { site } from '../../lib/site.ts';
import { registryUrl } from '../../lib/terraform-map.ts';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const s = ui(lang);
const map = site.terraformMap!;
const matchClass = { 'one-to-one': 'text-ok', partial: 'text-warn', gap: 'text-bad' } as const;
const host = (u: string) => new URL(u).hostname.replace(/^docs\./, '');
---

<Base lang={lang} title={`${s.tfTitle} — ${BRAND.name}`} description={s.tfIntro(map.providers.azurerm, map.providers.aws, map.providers.google)} altPath="terraform/">
  <h1 class="mb-2 text-2xl font-bold tracking-tight sm:text-3xl">{s.dictionary}</h1>
  <DictionaryTabs lang={lang} current="terraform" />
  <p class="mb-8 max-w-3xl text-muted">{s.tfIntro(map.providers.azurerm, map.providers.aws, map.providers.google)}</p>

  <div class="flex flex-col gap-4" data-pagefind-body>
    {
      map.entries.map((e) => (
        <section id={e.id} class="scroll-mt-4 rounded-xl border border-line bg-surface">
          <header class="flex flex-wrap items-baseline gap-x-3 gap-y-1 border-b border-line px-4 py-3">
            <h2 class="text-base font-semibold">
              <a class="text-fg no-underline hover:underline" href={`#${e.id}`}>{t(e.title, lang)}</a>
            </h2>
            <span class:list={['text-xs font-semibold', matchClass[e.match]]}>{s.tfMatch[e.match]}</span>
            <span class="ml-auto flex gap-3 text-xs" data-pagefind-ignore>
              {e.capability && <a href={`${capabilitiesHref(lang)}#${e.capability}`}>{s.tfCapability}: {e.capability}</a>}
              {e.concept && <a href={`${conceptsHref(lang)}#${e.concept}`}>{s.tfConcept}: {e.concept}</a>}
            </span>
          </header>
          <div class="grid gap-px bg-line md:grid-cols-3">
            {PROVIDERS.map((p) => (
              <div class="bg-surface px-4 py-3">
                <h3 class="mb-1 text-xs font-bold tracking-wide uppercase" style={`color: ${PROVIDER_META[p].color}`}>{PROVIDER_META[p].short}</h3>
                {e.resources[p].length === 0 ? (
                  <p class="text-sm text-bad">{s.gap}</p>
                ) : (
                  <ul class="flex flex-col gap-0.5">
                    {e.resources[p].map((r) => (
                      <li>
                        <a class="inline-flex min-h-6 items-center font-mono text-[13px] break-all" href={registryUrl(r)} target="_blank" rel="noopener">
                          {r}
                        </a>
                        {r.includes('.') && <span class="ml-1 text-xs text-muted">({s.tfBlock})</span>}
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            ))}
          </div>
          {e.notes && (
            <div class="border-t border-line px-4 py-3 text-sm">
              <p class="text-muted">{t(e.notes, lang)}</p>
              {e.sources.length > 0 && (
                <p class="mt-1 flex flex-wrap gap-x-3 text-xs" data-pagefind-ignore>
                  {e.sources.map((src) => (
                    <a class="inline-flex min-h-6 items-center" href={src} target="_blank" rel="noopener">↗ {host(src)}</a>
                  ))}
                </p>
              )}
            </div>
          )}
        </section>
      ))
    }
  </div>
</Base>
