---
import { BRAND } from '../lib/brand.ts';
import '../styles/global.css';
import { ui, LOCALES, PROVIDER_META, type Locale } from '../lib/i18n.ts';
import { PROVIDERS } from '../lib/schema.ts';
import { adrHref, capabilitiesHref, decideHref, examsHref, homeHref, href, migrateHref, practiceHref } from '../lib/paths.ts';

interface Props {
  lang: Locale;
  title: string;
  description: string;
  /** Path equivalente en el otro idioma, sin el prefijo de idioma (ej. "patterns/x/"). */
  altPath?: string;
  /** Path de la imagen OG relativo al sitio (ej. "og/es/home.png"). */
  ogImage?: string;
}

const { lang, title, description, altPath = '', ogImage = `og/${lang}/home.png` } = Astro.props;
const s = ui(lang);
const repo = BRAND.repo;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(href(ogImage), Astro.site).href;
// Pestaña activa según la sección de la URL (sin prefijo de idioma).
const rest = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '').replace(/^\/(es|en)\//, '');
const section = /^patterns\//.test(rest) ? 'patterns' : /^(capabilities|concepts|terraform)\//.test(rest) ? 'dictionary' : /^decide\//.test(rest) ? 'decide' : /^practice\//.test(rest) ? 'practice' : /^exams\//.test(rest) ? 'exams' : '';
const tabs = [
  { id: 'patterns', label: s.patterns, href: `${homeHref(lang)}#patterns` },
  { id: 'dictionary', label: s.dictionary, href: capabilitiesHref(lang) },
  { id: 'decide', label: s.decideTab, href: decideHref(lang) },
  { id: 'practice', label: s.practice, href: practiceHref(lang) },
  { id: 'exams', label: s.examsNav, href: examsHref(lang) },
];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    {LOCALES.map((l) => <link rel="alternate" hreflang={l} href={new URL(href(`${l}/${altPath}`), Astro.site).href} />)}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'es' ? 'es_AR' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="icon" type="image/svg+xml" href={href('favicon.svg')} />
    <link rel="manifest" href={href('manifest.webmanifest')} />
    <link rel="apple-touch-icon" href={href('icons/192.png')} />
    <meta name="theme-color" content="#4338ca" />
    <script is:inline>
      // "Mi nube" (F4-09) se aplica antes de pintar para que las notas no parpadeen.
      try {
        const o = localStorage.getItem('letra-chica:origin');
        if (o === 'azure' || o === 'aws' || o === 'gcp') document.documentElement.dataset.origin = o;
        const th = localStorage.getItem('letra-chica:theme');
        if (th === 'light' || th === 'dark') document.documentElement.dataset.theme = th;
      } catch { /* localStorage no disponible: se ignora */ }
    </script>
    <link rel="alternate" type="application/atom+xml" title={`${BRAND.name} — ${s.changesTitle}`} href={href(`${lang}/feed.xml`)} />
  </head>
  <body class="min-h-screen">
    <header class="lc-top">
      <div class="lc-topin">
        <a href={homeHref(lang)} class="lc-logo">
          <img src={href('favicon.svg')} alt="" width="24" height="24" />
          {BRAND.name}
        </a>
        <nav class="lc-tabs" aria-label={s.navSections}>
          {
            tabs.map((tb) => (
              <a class:list={['lc-tab', { on: tb.id === section }]} href={tb.href} aria-current={tb.id === section ? 'page' : undefined}>
                {tb.label}
              </a>
            ))
          }
        </nav>
        <div class="lc-topr">
          <a class="lc-iconbtn" href={href(`${lang}/search/`)} aria-label={s.search} title={s.search}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"></circle><path d="M16 16l4.5 4.5"></path></svg>
          </a>
          <label id="origin-picker" class="lc-origin" title={s.originHint} style="visibility: hidden">
            <span>{s.originLabel}</span>
            <select id="origin-select">
              <option value="">{s.originNone}</option>
              {PROVIDERS.map((p) => <option value={p}>{PROVIDER_META[p].short}</option>)}
            </select>
          </label>
          <div class="lc-seg lc-theme" role="group" aria-label={s.themeGroup}>
            <button type="button" data-theme-set="light" aria-label={s.themeLight} title={s.themeLight}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6"></path></svg>
            </button>
            <button type="button" data-theme-set="auto" aria-label={s.themeAuto} title={s.themeAuto}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.5"></circle><path class="half" d="M12 3.5a8.5 8.5 0 0 1 0 17z"></path></svg>
            </button>
            <button type="button" data-theme-set="dark" aria-label={s.themeDark} title={s.themeDark}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.2A8.2 8.2 0 0 1 9.8 4a8.2 8.2 0 1 0 10.2 10.2z"></path></svg>
            </button>
          </div>
          <div class="lc-seg lc-lang" role="group" aria-label="Idioma / Language">
            {
              LOCALES.map((l) =>
                l === lang ? (
                  <span class="on" aria-current="page">{l.toUpperCase()}</span>
                ) : (
                  <a href={href(`${l}/${altPath}`)} hreflang={l} lang={l}>{l.toUpperCase()}</a>
                ),
              )
            }
          </div>
        </div>
      </div>
    </header>
    <main class="mx-auto max-w-[1180px] px-4 py-10 sm:px-[22px]">
      <slot />
    </main>
    <footer class="lc-foot">
      <div class="mx-auto grid max-w-[1180px] gap-6 px-4 py-8 text-xs text-muted sm:grid-cols-[minmax(0,2fr)_minmax(0,1fr)_minmax(0,1fr)] sm:px-[22px]">
        <div class="flex flex-col gap-2">
          <p class="max-w-xl">{s.disclaimer}</p>
          <p>{s.license}</p>
          <p id="offline-status" aria-live="polite" hidden></p>
        </div>
        <nav class="flex flex-col gap-1.5" aria-label={s.footTools}>
          <p class="font-semibold text-fg">{s.footTools}</p>
          <a href={decideHref(lang)}>{s.decideNav}</a>
          <a href={migrateHref(lang)}>{s.migrateNav}</a>
          <a href={adrHref(lang)}>{s.adrNav}</a>
          <button type="button" id="offline-save" class="w-fit text-left text-accent" data-saving={s.offlineSaving} data-saved={s.offlineSaved} data-error={s.offlineError} hidden>{s.offlineSave}</button>
        </nav>
        <nav class="flex flex-col gap-1.5" aria-label={s.footProject}>
          <p class="font-semibold text-fg">{s.footProject}</p>
          <a href={href(`${lang}/methodology/`)}>{s.methodology}</a>
          <a href={href(`${lang}/changes/`)}>{s.changesNav}</a>
          <a href={href('api/v1/index.json')}>{s.openData}</a>
          <a href={`${repo}/blob/main/CONTRIBUTING.md`}>{s.contribute}</a>
          <a href={repo}>GitHub</a>
        </nav>
      </div>
    </footer>
    <script>
      import { applyOrigin, ORIGIN_KEY } from '../lib/origin-client.ts';

      const picker = document.getElementById('origin-picker');
      const select = document.getElementById('origin-select') as HTMLSelectElement | null;
      if (picker && select) {
        // Ocupa su lugar desde el HTML (visibility, no hidden): mostrarlo no mueve el header (CLS).
        picker.style.visibility = "";
        select.value = document.documentElement.dataset.origin ?? '';
        select.addEventListener('change', () => {
          try {
            if (select.value) localStorage.setItem(ORIGIN_KEY, select.value);
            else localStorage.removeItem(ORIGIN_KEY);
          } catch {
            /* sin storage: vale para esta página */
          }
          applyOrigin(select.value);
        });
        applyOrigin(select.value);
      }

      // Tema claro / automático / oscuro (persistido; "auto" sigue al sistema).
      const THEME_KEY = 'letra-chica:theme';
      const themeBtns = [...document.querySelectorAll<HTMLButtonElement>('[data-theme-set]')];
      const paintTheme = () => {
        const cur = document.documentElement.dataset.theme ?? 'auto';
        themeBtns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.themeSet === cur)));
      };
      themeBtns.forEach((b) =>
        b.addEventListener('click', () => {
          const v = b.dataset.themeSet!;
          if (v === 'auto') delete document.documentElement.dataset.theme;
          else document.documentElement.dataset.theme = v;
          try {
            if (v === 'auto') localStorage.removeItem(THEME_KEY);
            else localStorage.setItem(THEME_KEY, v);
          } catch {
            /* sin storage: vale para esta página */
          }
          paintTheme();
        }),
      );
      paintTheme();

      // PWA (F4-19): solo en el build publicado, para no cachear el servidor de desarrollo.
      const saveBtn = document.getElementById('offline-save') as HTMLButtonElement | null;
      const status = document.getElementById('offline-status');
      if (import.meta.env.PROD && 'serviceWorker' in navigator && saveBtn && status) {
        const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
        navigator.serviceWorker.register(`${base}sw.js`, { scope: base }).then(() => (saveBtn.hidden = false)).catch(() => {});
        const fill = (tpl: string, v: Record<string, number>) => tpl.replace(/\{(\w+)\}/g, (_, k) => String(v[k]));
        navigator.serviceWorker.addEventListener('message', (e) => {
          const d = e.data ?? {};
          if (d.type === 'offline-progress') status.textContent = fill(saveBtn.dataset.saving!, d);
          if (d.type === 'offline-done') {
            status.textContent = fill(saveBtn.dataset.saved!, d);
            saveBtn.disabled = false;
          }
        });
        saveBtn.addEventListener('click', async () => {
          status.hidden = false;
          try {
            const reg = await navigator.serviceWorker.ready;
            saveBtn.disabled = true;
            reg.active?.postMessage({ type: 'save-offline' });
          } catch {
            status.textContent = saveBtn.dataset.error!;
          }
        });
      }
    </script>
  </body>
</html>
